# Supabase -> Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> Settings -> API Keys. The publishable key (sb_publishable_...)
# supersedes the older anon key; either name works, publishable wins.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase -> Settings -> API Keys -> secret key. Server side only, never
# exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase -> Settings -> Database -> Connection pooler (session mode, port 5432).
# Do NOT use the direct connection: db.<ref>.supabase.co resolves to IPv6 only,
# and an IPv4-only network cannot reach it at all.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
